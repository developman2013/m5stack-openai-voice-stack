OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-realtime-mini
OPENAI_VOICE=cedar
ASSISTANT_INSTRUCTIONS="You are a concise, helpful smart home voice assistant. Always answer in Russian unless the user clearly speaks another language. Keep answers short and natural for spoken conversation."
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_home_assistant_long_lived_token
LISTEN_PORT=8765
LAST_INPUT_PCM_PATH=/tmp/openai-last-input.pcm
WAKE_WORD_ENABLED=false
WAKE_WORD_HOST=homeassistant.local
WAKE_WORD_PORT=10400
WAKE_WORD_NAME=hey_jarvis
WAKE_AUDIO_GAIN=8
FOLLOW_UP_TIMEOUT_MS=5000
